{
  "name": "rulereceipt",
  "version": "0.1.105",
  "description": "Did it push straight to main? Touch a file you told it never to? RuleReceipt checks the finished session against your CLAUDE.md / AGENTS.md rules and marks each followed, broken, or can't-tell, with the exact line as proof. Reads sessions from Claude Code, OpenAI Codex, GitHub Copilot CLI, Cursor, Google Antigravity, OpenCode, Cline and Devin Desktop; also reads Cursor, Copilot, Windsurf and Gemini rules files. Runs locally, nothing uploaded.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulereceipt/rulereceipt.git"
  },
  "homepage": "https://rulereceipt.dev",
  "bugs": {
    "url": "https://github.com/rulereceipt/rulereceipt/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "cursor",
    "copilot",
    "windsurf",
    "gemini",
    "agents",
    "agents-md",
    "ai-agent",
    "code-review",
    "audit",
    "compliance",
    "cli"
  ],
  "type": "module",
  "bin": {
    "rulereceipt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_LICENSES.txt",
    "sbom.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "license:check": "node scripts/license-gate.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "prepare": "node scripts/install-git-hooks.mjs",
    "prepublishOnly": "npm run build && npm run sbom && npm test",
    "build:checker": "esbuild src/browser/analyze.ts --bundle --format=esm --minify --outfile=landing/checker.js",
    "verify": "npm run lint && npm run typecheck && npm test",
    "gates": "bash scripts/gates.sh",
    "gates:selftest": "bash scripts/gate-selftest.sh",
    "version": "node scripts/bump-readme-action-tag.mjs && git add README.md"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/sdk": "~0.131.0",
    "commander": "~15.0.0",
    "nodemailer": "~10.0.1"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.9.1",
    "fast-check": "^4.10.2",
    "secretlint": "^13.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  }
}
