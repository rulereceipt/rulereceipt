{
  "name": "rulereceipt",
  "version": "0.1.28",
  "description": "Checks whether a Claude Code session actually followed your CLAUDE.md / AGENTS.md rules, with evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rulereceipt/rulereceipt.git"
  },
  "homepage": "https://rulereceipt.dev",
  "bugs": {
    "url": "https://github.com/rulereceipt/rulereceipt/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "agents",
    "ai-agent",
    "code-review",
    "audit",
    "compliance",
    "cli"
  ],
  "type": "module",
  "bin": {
    "rulereceipt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm test",
    "build:checker": "esbuild src/browser/analyze.ts --bundle --format=esm --minify --outfile=landing/checker.js",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "commander": "^15.0.0",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
