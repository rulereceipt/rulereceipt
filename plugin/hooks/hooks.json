{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "npx --yes rulereceipt guard" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "npx --yes rulereceipt hook" }
        ]
      }
    ]
  }
}
